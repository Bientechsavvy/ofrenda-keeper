# The app never reads this file. Copy the lines you need into `export` commands
# (local) or the Render Environment tab (hosted). Never commit a real key.
# LLM_BACKEND=none      -> remembrance written by plain code (no model)
# LLM_BACKEND=ollama    -> open model on this computer (private, offline)
# LLM_BACKEND=backboard -> hosted model (public demo only, made-up people)
LLM_BACKEND=none
DEMO_MODE=0
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=openrouter
BACKBOARD_MODEL=moonshotai/kimi-k2.6
MODEL_MAX_PER_HOUR=60
